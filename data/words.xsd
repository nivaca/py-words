<?xml version="1.0" encoding="UTF-8"?>
<!-- The format of the WORDS data files: dictionary.xml (and special.xml),
     inflections.xml, uniques.xml, addons.xml, sources.xml and gloss.xml.

     Which attributes an element needs depends on its part of speech (pos),
     which XML Schema 1.0 cannot express: here they are all optional, and
     each is documented with the parts of speech that use it.  The checker
     (python3 words_check.py) checks this too, as WORDS does when
     it reads the files.  The order of the elements matters. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- Codes -->

  <xs:simpleType name="dictionaryPos">
    <xs:annotation><xs:documentation>Part of speech of a dictionary entry.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="N"/>
      <xs:enumeration value="PRON"/>
      <xs:enumeration value="PACK"/>
      <xs:enumeration value="ADJ"/>
      <xs:enumeration value="NUM"/>
      <xs:enumeration value="ADV"/>
      <xs:enumeration value="V"/>
      <xs:enumeration value="PREP"/>
      <xs:enumeration value="CONJ"/>
      <xs:enumeration value="INTERJ"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="inflectionPos">
    <xs:annotation><xs:documentation>Part of speech of an inflection or unique form.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="N"/>
      <xs:enumeration value="PRON"/>
      <xs:enumeration value="PACK"/>
      <xs:enumeration value="ADJ"/>
      <xs:enumeration value="NUM"/>
      <xs:enumeration value="ADV"/>
      <xs:enumeration value="V"/>
      <xs:enumeration value="VPAR"/>
      <xs:enumeration value="SUPINE"/>
      <xs:enumeration value="PREP"/>
      <xs:enumeration value="CONJ"/>
      <xs:enumeration value="INTERJ"/>
      <xs:enumeration value="TACKON"/>
      <xs:enumeration value="PREFIX"/>
      <xs:enumeration value="SUFFIX"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="anyPos">
    <xs:annotation><xs:documentation>Any part of speech (X: any).</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="X"/>
      <xs:enumeration value="N"/>
      <xs:enumeration value="PRON"/>
      <xs:enumeration value="PACK"/>
      <xs:enumeration value="ADJ"/>
      <xs:enumeration value="NUM"/>
      <xs:enumeration value="ADV"/>
      <xs:enumeration value="V"/>
      <xs:enumeration value="VPAR"/>
      <xs:enumeration value="SUPINE"/>
      <xs:enumeration value="PREP"/>
      <xs:enumeration value="CONJ"/>
      <xs:enumeration value="INTERJ"/>
      <xs:enumeration value="TACKON"/>
      <xs:enumeration value="PREFIX"/>
      <xs:enumeration value="SUFFIX"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="targetPos">
    <xs:annotation><xs:documentation>Part of speech that a suffix produces or a tackon attaches to (X: any).</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="X"/>
      <xs:enumeration value="N"/>
      <xs:enumeration value="PRON"/>
      <xs:enumeration value="PACK"/>
      <xs:enumeration value="ADJ"/>
      <xs:enumeration value="NUM"/>
      <xs:enumeration value="ADV"/>
      <xs:enumeration value="V"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="gender">
    <xs:annotation><xs:documentation>M masculine, F feminine, N neuter, C common, X unknown/any.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="X"/>
      <xs:enumeration value="M"/>
      <xs:enumeration value="F"/>
      <xs:enumeration value="N"/>
      <xs:enumeration value="C"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="case">
    <xs:annotation><xs:documentation>NOM GEN DAT ABL ACC VOC LOC; X unknown/any.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="X"/>
      <xs:enumeration value="NOM"/>
      <xs:enumeration value="VOC"/>
      <xs:enumeration value="GEN"/>
      <xs:enumeration value="LOC"/>
      <xs:enumeration value="DAT"/>
      <xs:enumeration value="ABL"/>
      <xs:enumeration value="ACC"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="number">
    <xs:annotation><xs:documentation>S singular, P plural, X unknown/any.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="X"/>
      <xs:enumeration value="S"/>
      <xs:enumeration value="P"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="comparison">
    <xs:annotation><xs:documentation>POS positive, COMP comparative, SUPER superlative, X all/unknown.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="X"/>
      <xs:enumeration value="POS"/>
      <xs:enumeration value="COMP"/>
      <xs:enumeration value="SUPER"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="numeralSort">
    <xs:annotation><xs:documentation>CARD cardinal, ORD ordinal, DIST distributive, ADVERB numeral adverb, X all/unknown.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="X"/>
      <xs:enumeration value="CARD"/>
      <xs:enumeration value="ORD"/>
      <xs:enumeration value="DIST"/>
      <xs:enumeration value="ADVERB"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tense">
    <xs:annotation><xs:documentation>PRES IMPF FUT PERF PLUP FUTP; X unknown/any.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="X"/>
      <xs:enumeration value="PRES"/>
      <xs:enumeration value="IMPF"/>
      <xs:enumeration value="FUT"/>
      <xs:enumeration value="PERF"/>
      <xs:enumeration value="PLUP"/>
      <xs:enumeration value="FUTP"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="voice">
    <xs:annotation><xs:documentation>ACTIVE PASSIVE; X unknown/any.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="X"/>
      <xs:enumeration value="ACTIVE"/>
      <xs:enumeration value="PASSIVE"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="mood">
    <xs:annotation><xs:documentation>IND SUB IMP INF PPL; X unknown/any.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="X"/>
      <xs:enumeration value="IND"/>
      <xs:enumeration value="SUB"/>
      <xs:enumeration value="IMP"/>
      <xs:enumeration value="INF"/>
      <xs:enumeration value="PPL"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="kind">
    <xs:annotation><xs:documentation>Kind of noun (X S M A G N P T L W), pronoun (X PERS REL REFLEX DEMONS INTERR INDEF ADJECT) or verb (X TO_BE TO_BEING GEN DAT ABL TRANS INTRANS IMPERS DEP SEMIDEP PERFDEF).</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="X"/>
      <xs:enumeration value="S"/>
      <xs:enumeration value="M"/>
      <xs:enumeration value="A"/>
      <xs:enumeration value="G"/>
      <xs:enumeration value="N"/>
      <xs:enumeration value="P"/>
      <xs:enumeration value="T"/>
      <xs:enumeration value="L"/>
      <xs:enumeration value="W"/>
      <xs:enumeration value="PERS"/>
      <xs:enumeration value="REL"/>
      <xs:enumeration value="REFLEX"/>
      <xs:enumeration value="DEMONS"/>
      <xs:enumeration value="INTERR"/>
      <xs:enumeration value="INDEF"/>
      <xs:enumeration value="ADJECT"/>
      <xs:enumeration value="TO_BE"/>
      <xs:enumeration value="TO_BEING"/>
      <xs:enumeration value="GEN"/>
      <xs:enumeration value="DAT"/>
      <xs:enumeration value="ABL"/>
      <xs:enumeration value="TRANS"/>
      <xs:enumeration value="INTRANS"/>
      <xs:enumeration value="IMPERS"/>
      <xs:enumeration value="DEP"/>
      <xs:enumeration value="SEMIDEP"/>
      <xs:enumeration value="PERFDEF"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="age">
    <xs:annotation><xs:documentation>When the word was used (X: always).  Default X.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="X"/>
      <xs:enumeration value="A"/>
      <xs:enumeration value="B"/>
      <xs:enumeration value="C"/>
      <xs:enumeration value="D"/>
      <xs:enumeration value="E"/>
      <xs:enumeration value="F"/>
      <xs:enumeration value="G"/>
      <xs:enumeration value="H"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="area">
    <xs:annotation><xs:documentation>Subject area (X: general).  Default X.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="X"/>
      <xs:enumeration value="A"/>
      <xs:enumeration value="B"/>
      <xs:enumeration value="D"/>
      <xs:enumeration value="E"/>
      <xs:enumeration value="G"/>
      <xs:enumeration value="L"/>
      <xs:enumeration value="P"/>
      <xs:enumeration value="S"/>
      <xs:enumeration value="T"/>
      <xs:enumeration value="W"/>
      <xs:enumeration value="Y"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="geo">
    <xs:annotation><xs:documentation>Where the word was used (X: everywhere).  Default X.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="X"/>
      <xs:enumeration value="A"/>
      <xs:enumeration value="B"/>
      <xs:enumeration value="C"/>
      <xs:enumeration value="D"/>
      <xs:enumeration value="E"/>
      <xs:enumeration value="F"/>
      <xs:enumeration value="G"/>
      <xs:enumeration value="H"/>
      <xs:enumeration value="I"/>
      <xs:enumeration value="J"/>
      <xs:enumeration value="K"/>
      <xs:enumeration value="N"/>
      <xs:enumeration value="P"/>
      <xs:enumeration value="Q"/>
      <xs:enumeration value="R"/>
      <xs:enumeration value="S"/>
      <xs:enumeration value="U"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="freq">
    <xs:annotation><xs:documentation>How frequent the word is: A (very frequent) to F (very rare), or the special codes I M N; X unknown.  Default X.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="X"/>
      <xs:enumeration value="A"/>
      <xs:enumeration value="B"/>
      <xs:enumeration value="C"/>
      <xs:enumeration value="D"/>
      <xs:enumeration value="E"/>
      <xs:enumeration value="F"/>
      <xs:enumeration value="I"/>
      <xs:enumeration value="M"/>
      <xs:enumeration value="N"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="source">
    <xs:annotation><xs:documentation>The source of the entry (X: general).  Default X.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="X"/>
      <xs:enumeration value="A"/>
      <xs:enumeration value="B"/>
      <xs:enumeration value="C"/>
      <xs:enumeration value="D"/>
      <xs:enumeration value="E"/>
      <xs:enumeration value="F"/>
      <xs:enumeration value="G"/>
      <xs:enumeration value="H"/>
      <xs:enumeration value="I"/>
      <xs:enumeration value="J"/>
      <xs:enumeration value="K"/>
      <xs:enumeration value="L"/>
      <xs:enumeration value="M"/>
      <xs:enumeration value="N"/>
      <xs:enumeration value="O"/>
      <xs:enumeration value="P"/>
      <xs:enumeration value="Q"/>
      <xs:enumeration value="R"/>
      <xs:enumeration value="S"/>
      <xs:enumeration value="T"/>
      <xs:enumeration value="U"/>
      <xs:enumeration value="V"/>
      <xs:enumeration value="W"/>
      <xs:enumeration value="Y"/>
      <xs:enumeration value="Z"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="decn">
    <xs:annotation><xs:documentation>A declension or conjugation and its variant, as "2 1".</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string"><xs:pattern value="[0-9] [0-9]"/></xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="stem">
    <xs:annotation><xs:documentation>A stem or form: letters only, at most 18.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string"><xs:pattern value="[A-Za-z]{0,18}"/></xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="fix">
    <xs:annotation><xs:documentation>A prefix, suffix or tackon: letters only, at most 18.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string"><xs:pattern value="[A-Za-z]{1,18}"/></xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ending">
    <xs:annotation><xs:documentation>An inflectional ending: letters only, at most 7 (empty for none).</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string"><xs:pattern value="[A-Za-z]{0,7}"/></xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="connect">
    <xs:annotation><xs:documentation>The letter that must follow a prefix (or precede a suffix).</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string"><xs:pattern value="."/></xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="meaning">
    <xs:annotation><xs:documentation>A meaning, on one line.  WORDS uses its first 80 characters.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string"><xs:pattern value="[^\r\n]*"/></xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="key">
    <xs:annotation><xs:documentation>Which stem (1-4) an ending or affix attaches to; 0 for any.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:nonNegativeInteger"><xs:minInclusive value="0"/><xs:maxInclusive value="9"/></xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="person">
    <xs:annotation><xs:documentation>Person of a verb form (0 for none).</xs:documentation></xs:annotation>
    <xs:restriction base="xs:nonNegativeInteger"><xs:minInclusive value="0"/><xs:maxInclusive value="3"/></xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="value">
    <xs:annotation><xs:documentation>Numeric value of a numeral.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:nonNegativeInteger"><xs:minInclusive value="0"/><xs:maxInclusive value="1000"/></xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="id">
    <xs:annotation><xs:documentation>The id of an entry, irregular form or affix: a number that stays the same when others are added or moved, which the translations of the meanings (languages/*.xml) refer to.  Each one is used once in its file; if there is none, the position in the file is used.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:positiveInteger"><xs:maxExclusive value="1000000000"/></xs:restriction>
  </xs:simpleType>

  <!-- Attribute groups -->

  <xs:attributeGroup name="part">
    <xs:annotation><xs:documentation>The grammatical description of a dictionary word.</xs:documentation></xs:annotation>
    <xs:attribute name="decl" type="decn">
      <xs:annotation><xs:documentation>Required for N PRON PACK ADJ NUM.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="conj" type="decn">
      <xs:annotation><xs:documentation>Required for V.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gender" type="gender">
      <xs:annotation><xs:documentation>Required for N.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="kind" type="kind">
      <xs:annotation><xs:documentation>Required for N PRON PACK V.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="comparison" type="comparison">
      <xs:annotation><xs:documentation>Required for ADJ ADV.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sort" type="numeralSort">
      <xs:annotation><xs:documentation>Required for NUM.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="value">
      <xs:annotation><xs:documentation>Required for NUM.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="case" type="case">
      <xs:annotation><xs:documentation>Required for PREP.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <xs:attributeGroup name="qual">
    <xs:annotation><xs:documentation>The grammatical description of an inflected form.</xs:documentation></xs:annotation>
    <xs:attribute name="decl" type="decn">
      <xs:annotation><xs:documentation>Required for N PRON PACK ADJ NUM.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="conj" type="decn">
      <xs:annotation><xs:documentation>Required for V VPAR SUPINE.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="case" type="case">
      <xs:annotation><xs:documentation>Required for N PRON PACK ADJ NUM VPAR SUPINE PREP.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="number" type="number">
      <xs:annotation><xs:documentation>Required for N PRON PACK ADJ NUM V VPAR SUPINE.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="gender" type="gender">
      <xs:annotation><xs:documentation>Required for N PRON PACK ADJ NUM VPAR SUPINE.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="comparison" type="comparison">
      <xs:annotation><xs:documentation>Required for ADJ ADV.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="sort" type="numeralSort">
      <xs:annotation><xs:documentation>Required for NUM.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="tense" type="tense">
      <xs:annotation><xs:documentation>Required for V VPAR.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="voice" type="voice">
      <xs:annotation><xs:documentation>Required for V VPAR.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="mood" type="mood">
      <xs:annotation><xs:documentation>Required for V VPAR.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="person" type="person">
      <xs:annotation><xs:documentation>Required for V.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <xs:attributeGroup name="translation">
    <xs:attribute name="age" type="age" default="X"/>
    <xs:attribute name="area" type="area" default="X"/>
    <xs:attribute name="geo" type="geo" default="X"/>
    <xs:attribute name="freq" type="freq" default="X"/>
    <xs:attribute name="source" type="source" default="X"/>
  </xs:attributeGroup>

  <!-- dictionary.xml -->

  <xs:element name="dictionary">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="entry" minOccurs="0" maxOccurs="unbounded">
          <xs:annotation><xs:documentation>A dictionary entry.  Its stems are
            given in order (an empty &lt;stem/&gt; for a blank one; zzz for
            a form that does not exist); how many are used depends on the
            part of speech: N, PRON, PACK 2; ADJ, NUM, V 4; ADV 3; others 1.
          </xs:documentation></xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="stem" type="stem" maxOccurs="4"/>
              <xs:element name="meaning" type="meaning"/>
            </xs:sequence>
            <xs:attribute name="id" type="id"/>
            <xs:attribute name="pos" type="dictionaryPos" use="required"/>
            <xs:attributeGroup ref="part"/>
            <xs:attributeGroup ref="translation"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="oneEntryId">
      <xs:selector xpath="entry"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>

  <!-- inflections.xml -->

  <xs:element name="inflections">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="inflection" minOccurs="0" maxOccurs="unbounded">
          <xs:annotation><xs:documentation>An ending, the form it makes and
            the stem it attaches to.</xs:documentation></xs:annotation>
          <xs:complexType>
            <xs:attribute name="pos" type="inflectionPos" use="required"/>
            <xs:attributeGroup ref="qual"/>
            <xs:attribute name="key" type="key" use="required"/>
            <xs:attribute name="ending" type="ending" default=""/>
            <xs:attribute name="age" type="age" default="X"/>
            <xs:attribute name="freq" type="freq" default="X"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- uniques.xml -->

  <xs:element name="uniques">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="unique" minOccurs="0" maxOccurs="unbounded">
          <xs:annotation><xs:documentation>An irregular form, complete in
            itself.  kind is required for N PRON PACK V VPAR SUPINE, value
            for NUM.</xs:documentation></xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="form" type="fix"/>
              <xs:element name="meaning" type="meaning"/>
            </xs:sequence>
            <xs:attribute name="id" type="id"/>
            <xs:attribute name="pos" type="inflectionPos" use="required"/>
            <xs:attributeGroup ref="qual"/>
            <xs:attribute name="kind" type="kind"/>
            <xs:attribute name="value" type="value"/>
            <xs:attributeGroup ref="translation"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="oneUniqueId">
      <xs:selector xpath="unique"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>

  <!-- addons.xml -->

  <xs:complexType name="target">
    <xs:attribute name="pos" type="targetPos" use="required"/>
    <xs:attributeGroup ref="part"/>
  </xs:complexType>

  <xs:element name="addons">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="prefix">
          <xs:annotation><xs:documentation>A prefix: added to a word of part
            of speech root, it makes one of part of speech target.
          </xs:documentation></xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="meaning" type="meaning"/>
            </xs:sequence>
            <xs:attribute name="id" type="id"/>
            <xs:attribute name="fix" type="fix" use="required"/>
            <xs:attribute name="connect" type="connect"/>
            <xs:attribute name="root" type="anyPos" use="required"/>
            <xs:attribute name="target" type="anyPos" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="suffix">
          <xs:annotation><xs:documentation>A suffix: added to stem rootkey of
            a word of part of speech root, it makes a word described by
            &lt;target&gt;, whose stem targetkey it is.
          </xs:documentation></xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="target" type="target"/>
              <xs:element name="meaning" type="meaning"/>
            </xs:sequence>
            <xs:attribute name="id" type="id"/>
            <xs:attribute name="fix" type="fix" use="required"/>
            <xs:attribute name="connect" type="connect"/>
            <xs:attribute name="root" type="anyPos" use="required"/>
            <xs:attribute name="rootkey" type="key" use="required"/>
            <xs:attribute name="targetkey" type="key" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="tackon">
          <xs:annotation><xs:documentation>An enclitic, attached to a word
            described by &lt;base&gt;.  Tackons on PACK 1 or 2 whose meaning
            starts with "PACKON w/" attach to qu- pronouns.
          </xs:documentation></xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="base" type="target"/>
              <xs:element name="meaning" type="meaning"/>
            </xs:sequence>
            <xs:attribute name="id" type="id"/>
            <xs:attribute name="fix" type="fix" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:choice>
    </xs:complexType>
    <xs:unique name="oneAddonId">
      <xs:selector xpath="prefix|suffix|tackon"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>

  <!-- sources.xml -->

  <xs:element name="sources">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="source" minOccurs="0" maxOccurs="unbounded">
          <xs:annotation><xs:documentation>What a source code (the source
            attribute of entries and irregular forms) stands for: a
            dictionary, grammar or word list.  Each code is listed once.
          </xs:documentation></xs:annotation>
          <xs:complexType>
            <xs:attribute name="code" type="source" use="required"/>
            <xs:attribute name="name" use="required">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:minLength value="1"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="oneCodeOnce">
      <xs:selector xpath="source"/>
      <xs:field xpath="@code"/>
    </xs:unique>
  </xs:element>

  <!-- gloss.xml -->

  <xs:element name="glosses">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="gloss" minOccurs="0" maxOccurs="unbounded">
          <xs:annotation><xs:documentation>The abbreviation that the
            analyses use for a grammatical value: the code of a category as
            in the other files (case GEN, tense PERF, person 3 ...), its
            abbreviation (Leipzig Glossing Rules where they have one), and
            what it means.  leipzig="yes" marks the standard Leipzig
            abbreviations.  Which codes each category has is checked by
            words_check.py.
          </xs:documentation></xs:annotation>
          <xs:complexType>
            <xs:attribute name="category" use="required">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:enumeration value="case"/>
                  <xs:enumeration value="number"/>
                  <xs:enumeration value="gender"/>
                  <xs:enumeration value="person"/>
                  <xs:enumeration value="tense"/>
                  <xs:enumeration value="voice"/>
                  <xs:enumeration value="mood"/>
                  <xs:enumeration value="form"/>
                  <xs:enumeration value="comparison"/>
                  <xs:enumeration value="sort"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="code" type="xs:string" use="required"/>
            <xs:attribute name="abbreviation" use="required">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:pattern value="[A-Z0-9]+(\.[A-Z0-9]+)*"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="meaning" type="xs:string" use="required"/>
            <xs:attribute name="leipzig" default="no">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:enumeration value="yes"/>
                  <xs:enumeration value="no"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="oneGlossOnce">
      <xs:selector xpath="gloss"/>
      <xs:field xpath="@category"/>
      <xs:field xpath="@code"/>
    </xs:unique>
  </xs:element>

  <!-- interface/*.xml -->

  <xs:element name="interface">
    <xs:annotation><xs:documentation>A language of the interface of the
      programs (the menus, buttons, messages and help), in
      interface/CODE.xml next to the program: each &lt;text&gt; gives an
      English text of the programs (&lt;en&gt;, found with its spaces made
      single) and its translation (&lt;tr&gt;, shown as it is written),
      with the same {parts}.  What is not translated is shown in English.
    </xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="text" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="en" type="xs:string"/>
              <xs:element name="tr" type="xs:string"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="code" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[a-z]{2,3}(-[A-Za-z0-9]{1,8})*"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="native" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- languages/*.xml -->

  <xs:simpleType name="words">
    <xs:annotation><xs:documentation>Words separated by spaces.</xs:documentation></xs:annotation>
    <xs:list itemType="xs:string"/>
  </xs:simpleType>

  <xs:element name="language">
    <xs:annotation><xs:documentation>A language of the meanings, in
      languages/CODE.xml.  English, the language of the meanings in the
      data files (reference="yes"), has no &lt;meaning&gt; elements; any
      other language gives the meanings it translates, and the English
      ones are shown for the rest.  The &lt;noise&gt; and &lt;common&gt;
      words are for the search from the language to Latin, and the
      &lt;numeral&gt; sentences say what a form of a numeral means; the
      &lt;text&gt;s translate the rest of the results.
    </xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="noise" type="words">
          <xs:annotation><xs:documentation>Words never looked for (articles,
            abbreviations ...).</xs:documentation></xs:annotation>
        </xs:element>
        <xs:element name="common">
          <xs:annotation><xs:documentation>Common words that say little
            about an entry when they are part of a longer phrase: they are
            not looked for there, unless the entry is of one of the parts
            of speech given in pos (none: of no part of speech).
          </xs:documentation></xs:annotation>
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="words">
                <xs:attribute name="pos">
                  <xs:simpleType><xs:list itemType="dictionaryPos"/></xs:simpleType>
                </xs:attribute>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
        <xs:element name="numeral">
          <xs:annotation><xs:documentation>What a numeral means, by its sort
            ({n} is replaced by its value); sort X: a form that is not a
            numeral (as the adverb of a numeral's entry).
          </xs:documentation></xs:annotation>
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="meaning">
                <xs:attribute name="sort" type="numeralSort" use="required"/>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
        <xs:element name="meaning">
          <xs:annotation><xs:documentation>The meaning, in this language, of
            the entry (of dictionary.xml), special entry (special.xml),
            irregular form (uniques.xml) or affix (addons.xml) with this id,
            or of an entry built into the program (builtin="esse").  One
            of the attributes is given.</xs:documentation></xs:annotation>
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="meaning">
                <xs:attribute name="entry" type="id"/>
                <xs:attribute name="special" type="id"/>
                <xs:attribute name="unique" type="id"/>
                <xs:attribute name="addon" type="id"/>
                <xs:attribute name="builtin">
                  <xs:simpleType>
                    <xs:restriction base="xs:string">
                      <xs:enumeration value="esse"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:attribute>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
        <xs:element name="text">
          <xs:annotation><xs:documentation>A text of the results other than
            the meanings (the grammar in words, the labels, the notes on
            tricks) in this language, by its English (en).  The English may
            be a pattern with {1}, {2} ... for its parts, which the text
            has too; the parts are translated as well, if they are texts.
            What is not translated is shown in English.
          </xs:documentation></xs:annotation>
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="meaning">
                <xs:attribute name="en" type="xs:string" use="required"/>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
      </xs:choice>
      <xs:attribute name="code" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[a-z]{2,3}(-[A-Za-z0-9]{1,8})*"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="name" type="xs:string" use="required">
        <xs:annotation><xs:documentation>The name in English (Spanish).</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="native" type="xs:string">
        <xs:annotation><xs:documentation>The name in the language itself (Español).</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="reference" default="no">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"/>
            <xs:enumeration value="no"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
    <xs:unique name="oneNumeralOnce">
      <xs:selector xpath="numeral"/>
      <xs:field xpath="@sort"/>
    </xs:unique>
    <xs:unique name="oneEntryMeaning">
      <xs:selector xpath="meaning"/>
      <xs:field xpath="@entry"/>
    </xs:unique>
    <xs:unique name="oneSpecialMeaning">
      <xs:selector xpath="meaning"/>
      <xs:field xpath="@special"/>
    </xs:unique>
    <xs:unique name="oneUniqueMeaning">
      <xs:selector xpath="meaning"/>
      <xs:field xpath="@unique"/>
    </xs:unique>
    <xs:unique name="oneAddonMeaning">
      <xs:selector xpath="meaning"/>
      <xs:field xpath="@addon"/>
    </xs:unique>
  </xs:element>

</xs:schema>
